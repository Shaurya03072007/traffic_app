# ==============================================================================
# TRAFFICWATCH BACKEND ENVIRONMENT CONFIGURATION
# ==============================================================================

# Server configuration
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173", "http://localhost:3000", "http://127.0.0.1:3000", "http://192.168.*.*"]

# Supabase Credentials (obtain from Project Settings > API)
SUPABASE_URL="https://your-project-ref.supabase.co"
SUPABASE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# JWT Secret for local auth verification
JWT_SECRET="traffic_police_secure_lan_jwt_secret_key_change_in_production_9981"
JWT_ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# AI Model settings
MODEL_PATH="models/yolov8n.pt"
CONFIDENCE_THRESHOLD=0.45
HELMET_CONFIDENCE_THRESHOLD=0.60
TRIPLE_RIDING_IOU_THRESHOLD=0.35

# Evidence Storage Directory (Local storage cache)
UPLOAD_STORAGE_DIR="storage/evidence"
MAX_UPLOAD_SIZE_MB=100
